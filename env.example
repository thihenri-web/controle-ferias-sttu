# Exemplo ilustrativo: nunca envie credenciais reais para o GitHub.
# DATABASE_URL vem da integração Neon na Vercel.
DATABASE_URL=postgresql://usuario:senha@host/database?sslmode=require
# Configure essas duas variáveis como Sensitive para Production na Vercel:
ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_UNICA_MIN_8_CARACTERES
ADMIN_SESSION_SECRET=SUBSTITUA_POR_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
